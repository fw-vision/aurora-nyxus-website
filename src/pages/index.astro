---
import Main from "../layouts/Main.astro";
import Wordmark from "../components/Wordmark.astro";
import Figure from "../components/Figure.astro";
import StepCard from "../components/StepCard.astro";
import MeshTopology from "../components/widgets/MeshTopology.tsx";
import BuildVsRent from "../components/widgets/BuildVsRent.tsx";
---

<Main>
  <!-- Full-bleed hero (Oxide field) -->
  <section class="relative min-h-[78vh] overflow-hidden sm:min-h-[85vh]">
    <img
      src="/images/hardware/hero-bg-workstation.webp"
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-[70%_center]"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-canvas via-canvas/80 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-canvas via-canvas/20 to-canvas/50"></div>
    <div
      class="relative z-10 mx-auto flex min-h-[78vh] max-w-6xl flex-col justify-end px-5 pb-16 pt-28 sm:min-h-[85vh] sm:pb-24"
    >
      <p class="mb-5 text-2xl sm:text-3xl"><Wordmark /></p>
      <h1
        class="font-display max-w-2xl text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl"
      >
        Compute you <span class="aurora-text">own</span>.
      </h1>
      <p class="mt-5 max-w-lg text-base leading-relaxed text-graphite sm:text-lg">
        High-performance AI compute you own and control. Premium workstations
        that chain to frontier scale, and meshed sovereign capacity on soil you
        trust.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/contact#request-a-build"
          class="rounded-sm border border-aurora-green/50 bg-aurora-green/10 px-5 py-2.5 font-mono text-sm font-medium text-aurora-green transition-colors hover:bg-aurora-green/20"
        >
          Request a build
        </a>
        <a
          href="/why-owned"
          class="rounded-sm border border-hairline px-5 py-2.5 font-mono text-sm font-medium text-graphite transition-colors hover:border-graphite/50 hover:text-ink"
        >
          See build vs rent
        </a>
      </div>
    </div>
  </section>

  <!-- Two tracks -->
  <section class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
    <div class="grid gap-px border border-hairline bg-hairline md:grid-cols-2">
      <a href="/workstations" class="group bg-canvas p-8 transition-colors hover:bg-surface/40 sm:p-10">
        <p class="mono-label mb-3 text-aurora-green">Track 1 — Workstations</p>
        <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">
          Premium, high-performance, scalable
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-graphite sm:text-base">
          Custom multi-GPU workstations and GB10 / DGX Spark systems for labs,
          quants, studios, and enterprise. Chain units over ConnectX-7 to run
          frontier models. Add hardware as you grow.
        </p>
        <p class="mt-5 font-mono text-xs text-aurora-green group-hover:underline">
          Explore workstations →
        </p>
      </a>
      <a href="/mesh-compute" class="group bg-canvas p-8 transition-colors hover:bg-surface/40 sm:p-10">
        <p class="mono-label mb-3 text-aurora-violet">Track 2 — Mesh Compute</p>
        <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">
          Scrappy, meshed, sovereign
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-graphite sm:text-base">
          Owned Canadian capacity meshed from old and new hardware. For
          government, Indigenous data sovereignty, and anyone who needs the box
          under their own roof.
        </p>
        <p class="mt-5 font-mono text-xs text-aurora-violet group-hover:underline">
          Explore mesh compute →
        </p>
      </a>
    </div>
  </section>

  <!-- Chain to scale -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="mono-label mb-4 text-aurora-green">Chain to scale</p>
        <h2 class="font-display text-3xl font-medium leading-tight text-ink sm:text-4xl">
          One unit today. Frontier scale when you need it.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-graphite">
          A single GB10 / DGX Spark unit runs models up to 200 billion
          parameters at 128 GB unified memory. Chain a second over ConnectX-7 at
          200 Gbps and reach 405-billion-parameter models. Add units and the
          cluster grows with your workload.
        </p>
      </div>
      <div class="space-y-6">
        <Figure
          src="/images/hardware/fig-02-chain-pair.webp"
          alt="Two identical workstation nodes with interconnect cabling"
          aspect="video"
        />
        <MeshTopology mode="premium" client:visible />
      </div>
    </div>
  </section>

  <!-- Spec / Build / Own -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <h2 class="font-display text-3xl font-medium text-ink sm:text-4xl">Spec. Build. Own.</h2>
    <div class="mt-12 grid gap-10 sm:grid-cols-3">
      <StepCard step="1" title="Spec">
        Tell us the workload and the models. We design the right system: GPUs,
        unified memory, chaining headroom.
      </StepCard>
      <StepCard step="2" title="Build">
        We build, stress-test under sustained load, and stand behind it.
      </StepCard>
      <StepCard step="3" title="Own">
        You run it on your terms, on your soil. Chain more units, or mesh what
        you have, as you grow.
      </StepCard>
    </div>
  </section>

  <!-- Build vs rent -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <div class="mb-10">
      <p class="mono-label mb-4 text-aurora-green">The honest math</p>
      <h2 class="font-display text-3xl font-medium leading-tight text-ink sm:text-4xl">
        Build vs rent, by workload
      </h2>
      <p class="mt-4 max-w-2xl text-graphite">
        Pick a workload. We estimate the cloud cost at live rates, the build
        that serves it, and when owning pays for itself.
      </p>
    </div>
    <BuildVsRent client:visible />
  </section>

  <!-- Why us -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <div class="grid gap-px border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-4">
      <div class="bg-canvas p-7 sm:p-8">
        <p class="mono-label mb-3 text-aurora-green">01</p>
        <h3 class="font-display text-lg font-medium text-ink">High-performance</h3>
        <p class="mt-3 text-sm leading-relaxed text-graphite">
          GB10 / DGX Spark systems that chain to frontier scale.
        </p>
      </div>
      <div class="bg-canvas p-7 sm:p-8">
        <p class="mono-label mb-3 text-signal">02</p>
        <h3 class="font-display text-lg font-medium text-ink">Scalable</h3>
        <p class="mt-3 text-sm leading-relaxed text-graphite">
          Start with one unit; add hardware as the models grow.
        </p>
      </div>
      <div class="bg-canvas p-7 sm:p-8">
        <p class="mono-label mb-3 text-aurora-violet">03</p>
        <h3 class="font-display text-lg font-medium text-ink">Sovereign</h3>
        <p class="mt-3 text-sm leading-relaxed text-graphite">
          Owned Canadian custody, CLOUD-Act-free, with DAI Compute.
        </p>
      </div>
      <div class="bg-canvas p-7 sm:p-8">
        <p class="mono-label mb-3 text-aurora-green">04</p>
        <h3 class="font-display text-lg font-medium text-ink">We dogfood it</h3>
        <p class="mt-3 text-sm leading-relaxed text-graphite">
          We run our own workloads on our own hardware.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-5 pb-24 pt-8 sm:pb-32">
    <div class="border border-hairline bg-surface/40 px-8 py-14 text-center sm:px-12 sm:py-16">
      <h2 class="font-display text-3xl font-medium text-ink sm:text-4xl">
        Own your compute.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-graphite">
        Tell us your models, context length, and timeline. We send a build spec
        you can deploy.
      </p>
      <a
        href="/contact#request-a-build"
        class="mt-8 inline-block rounded-sm border border-aurora-green/50 bg-aurora-green/10 px-6 py-3 font-mono text-sm font-medium text-aurora-green transition-colors hover:bg-aurora-green/20"
      >
        Request a build
      </a>
    </div>
  </section>
</Main>

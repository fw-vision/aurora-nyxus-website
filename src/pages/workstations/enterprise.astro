---
import Main from "../../layouts/Main.astro";
import PageHeader from "../../components/PageHeader.astro";
---

<Main title="Sovereign AI for Regulated Enterprise - Aurora Nyxus" description="Air-gapped, on-prem AI for finance and health. Data never leaves your walls.">
  <PageHeader
    eyebrow="Enterprise"
    title="Air-gapped AI for regulated industries"
    lede="On-prem AI behind your firewall, or fully air-gapped. Compliance-ready and verifiable."
    accent="green"
    bgSrc="/images/hardware/fig-02-chain-pair.webp"
    bgAlt="Chained workstation nodes for on-prem enterprise"
  />

  <section class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">Data stays inside</h2>
        <p class="mt-5 text-base leading-relaxed text-graphite">
          Regulated data cannot leave the perimeter. We deploy AI on hardware
          behind your firewall or fully air-gapped, so prompts, outputs, and
          fine-tuned models stay in your environment.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">Open models, your control</h2>
        <p class="mt-5 text-base leading-relaxed text-graphite">
          Run open models on owned hardware, or host a vendor's private
          deployment on our boxes. Either way, you keep control of the stack
          and the data.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    <div class="grid gap-px border border-hairline bg-hairline sm:grid-cols-3">
      <div class="bg-canvas p-7 sm:p-8">
        <p class="mono-label mb-3 text-aurora-green">01</p>
        <h3 class="font-display text-lg font-medium text-ink">Air-gapped option</h3>
        <p class="mt-3 text-sm leading-relaxed text-graphite">Fully isolated deployment behind your firewall.</p>
      </div>
      <div class="bg-canvas p-7 sm:p-8">
        <p class="mono-label mb-3 text-signal">02</p>
        <h3 class="font-display text-lg font-medium text-ink">Compliance-ready</h3>
        <p class="mt-3 text-sm leading-relaxed text-graphite">Built toward SOC 2, ISO, and sector requirements.</p>
      </div>
      <div class="bg-canvas p-7 sm:p-8">
        <p class="mono-label mb-3 text-aurora-violet">03</p>
        <h3 class="font-display text-lg font-medium text-ink">Own the stack</h3>
        <p class="mt-3 text-sm leading-relaxed text-graphite">Open models on owned hardware. No vendor lock-in.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24 pt-8 sm:pb-32">
    <a href="/contact" class="inline-block rounded-sm border border-aurora-green/50 bg-aurora-green/10 px-6 py-3 font-mono text-sm font-medium text-aurora-green transition-colors hover:bg-aurora-green/20">Discuss a deployment</a>
  </section>
</Main>

---
import Main from "../../layouts/Main.astro";
import PageHeader from "../../components/PageHeader.astro";
import SpecTable from "../../components/SpecTable.astro";
import FeatureCard from "../../components/FeatureCard.astro";

const rows = [
  { workload: "Training / fine-tuning", note: "neural nets, transformers", gpu: "multi-GPU RTX 6000-class", vram: "48 GB+", memory: "128-512 GB" },
  { workload: "Large-dataset inference", note: "batch, multi-user", gpu: "RTX 5090", vram: "24 GB", memory: "128 GB" },
  { workload: "Experimentation", note: "mixed workloads", gpu: "RTX 5090 / 4090", vram: "24 GB", memory: "64-128 GB" },
];
---

<Main title="AI Workstations for Research Labs - Aurora Nyxus" description="Multi-GPU AI workstations for universities and R&D: high VRAM, sustained-load stability, CUDA-ready, scalable.">
  <PageHeader
    eyebrow="Workstations / Research labs"
    title="Compute that keeps up with the research"
    lede="For university labs and corporate R&D training and fine-tuning models. High VRAM, thermal stability under long runs, a clean CUDA and Docker stack, and headroom to add GPUs as the work grows."
    glow
    fig="Fig. — Research labs"
  />

  <section class="mx-auto max-w-6xl px-5 py-10">
    <h2 class="font-display mb-5 text-2xl font-medium text-ink">Typical configurations</h2>
    <SpecTable rows={rows} caption="Specced to your training frameworks and dataset scale. Multi-GPU stability and cooling are the priorities for sustained research loads." />
  </section>

  <section class="mx-auto max-w-6xl px-5 py-10">
    <div class="grid gap-5 sm:grid-cols-3">
      <FeatureCard title="VRAM with headroom" index="01" accent="green">Sized so you are not re-buying in six months as models grow.</FeatureCard>
      <FeatureCard title="Sustained-load stable" index="02" accent="signal">Power delivery, airflow, and driver consistency tuned for long training runs.</FeatureCard>
      <FeatureCard title="Scales up" index="03" accent="violet">Add GPUs or mesh a second node as the lab's needs grow.</FeatureCard>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 pt-6">
    <a href="/contact#request-a-build" class="inline-block rounded-sm border border-aurora-green/50 bg-aurora-green/10 px-6 py-3 font-mono text-sm font-medium text-aurora-green transition-colors hover:bg-aurora-green/20">Request a lab build</a>
  </section>
</Main>

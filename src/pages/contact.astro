---
import Main from "../layouts/Main.astro";
import PageHeader from "../components/PageHeader.astro";
import BusinessCard from "../components/BusinessCard.astro";
---

<Main title="Contact - Aurora Nyxus" description="Request a build or discuss a sovereign deployment. Reach the Aurora Nyxus team.">
  <PageHeader
    eyebrow="Contact"
    title="Request a build. Or start a conversation."
    lede="Tell us your model, context length, dataset size, and timeline. We send back a build spec you can deploy."
    accent="green"
  />

  <section id="request-a-build" class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="border border-hairline bg-surface/40 p-8 sm:p-12">
      <p class="mono-label mb-4 text-aurora-green">Request a build</p>
      <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">Tell us the workload</h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-graphite">
        Send the model(s) you want to run, target context length, dataset size,
        whether it is workstation or sovereign on-prem, and your timeline. We
        reply with a recommended spec and a quote.
      </p>
      <a
        href="mailto:build@auroranyxus.com?subject=Build%20request&body=Workload%3A%0AModel(s)%3A%0AContext%20length%3A%0AWorkstation%20or%20sovereign%20on-prem%3A%0ATimeline%3A%0ABudget%20range%3A"
        class="mt-8 inline-block rounded-sm border border-aurora-green/50 bg-aurora-green/10 px-5 py-2.5 font-mono text-sm font-medium text-aurora-green transition-colors hover:bg-aurora-green/20"
      >
        build@auroranyxus.com
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24 pt-4 sm:pb-32">
    <h2 class="font-display mb-10 text-2xl font-medium text-ink sm:text-3xl">Reach a person</h2>
    <div class="grid gap-6 md:grid-cols-2">
      <BusinessCard
        name="Ben Wang"
        role="Hardware & builds"
        email="ben@auroranyxus.com"
        handle="github.com/NinARM1Builds"
        accent="green"
        slogan="Precision builds, stress-tested."
      />
      <BusinessCard
        name="General enquiries"
        role="Anything else"
        email="hello@auroranyxus.com"
        accent="signal"
        slogan="Compute you own."
      />
    </div>
  </section>
</Main>

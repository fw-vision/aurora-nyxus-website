---
import Main from "../layouts/Main.astro";
import PageHeader from "../components/PageHeader.astro";
import SpecTable from "../components/SpecTable.astro";
import FeatureCard from "../components/FeatureCard.astro";

const rows = [
  { workload: "Local LLM inference", note: "7B-32B, quantized", gpu: "RTX 5090", vram: "24 GB", memory: "64-128 GB" },
  { workload: "Model training / fine-tune", note: "multi-GPU", gpu: "RTX 6000-class / multi-5090", vram: "48 GB+", memory: "128-512 GB" },
  { workload: "Diffusion / generative", note: "image, video", gpu: "RTX 5090 / 4090", vram: "16-24 GB+", memory: "64 GB+" },
  { workload: "Agentic workflows", note: "24/7 automation", gpu: "RTX 5090", vram: "24 GB", memory: "64-128 GB" },
  { workload: "Mesh / mixed", note: "old + new, pooled", gpu: "5090 + 6900 XT + RX 580", vram: "pooled", memory: "per node" },
];
---

<Main title="Workstations - Aurora Nyxus" description="Premium custom AI workstations built in Canada: research labs, quant desks, studios. Specced to your workload, stress-tested, supported.">
  <PageHeader
    eyebrow="Door 1"
    title="Premium AI workstations, built in Canada"
    lede="Custom multi-GPU compute specced to your workload. Not a gaming rig with a sticker: engineered for sustained load, stress-tested, and supported. This is the cash-and-credibility engine, and the proof we can build what the sovereign work demands."
    glow
    fig="Fig. — Workstations"
  />

  <!-- Spec matrix -->
  <section class="mx-auto max-w-6xl px-5 py-10">
    <h2 class="font-display mb-5 text-2xl font-medium text-ink">
      Match hardware to workload
    </h2>
    <SpecTable
      rows={rows}
      caption="Guidance only. Final spec depends on model size, quantization, context length, cooling, power, and availability. Tell us the workload; we send a build spec with headroom."
    />
  </section>

  <!-- Segments -->
  <section class="mx-auto max-w-6xl px-5 py-10">
    <h2 class="font-display mb-6 text-2xl font-medium text-ink">
      Built for your work
    </h2>
    <div class="grid gap-px border border-hairline bg-hairline md:grid-cols-3">
      <a href="/workstations/research-labs" class="group bg-canvas p-7 transition-colors hover:bg-surface/40">
        <p class="mono-label mb-2 text-aurora-green">Research labs</p>
        <h3 class="font-display text-lg font-medium text-ink">Universities & R&D</h3>
        <p class="mt-2 text-sm text-graphite">High VRAM, sustained-load stability, CUDA-ready, room to scale.</p>
        <p class="mt-3 font-mono text-xs text-aurora-green group-hover:underline">Details →</p>
      </a>
      <a href="/workstations/quant-finance" class="group bg-canvas p-7 transition-colors hover:bg-surface/40">
        <p class="mono-label mb-2 text-signal">Quant & finance</p>
        <h3 class="font-display text-lg font-medium text-ink">Funds & trading</h3>
        <p class="mt-2 text-sm text-graphite">Owned, private, low-latency compute. Discretion and track record.</p>
        <p class="mt-3 font-mono text-xs text-signal group-hover:underline">Details →</p>
      </a>
      <a href="/workstations/studios" class="group bg-canvas p-7 transition-colors hover:bg-surface/40">
        <p class="mono-label mb-2 text-aurora-violet">Studios</p>
        <h3 class="font-display text-lg font-medium text-ink">Creative & media</h3>
        <p class="mt-2 text-sm text-graphite">Throughput for generative pipelines, reliable under long renders.</p>
        <p class="mt-3 font-mono text-xs text-aurora-violet group-hover:underline">Details →</p>
      </a>
    </div>
  </section>

  <!-- What you get -->
  <section class="mx-auto max-w-6xl px-5 py-10">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <FeatureCard title="Workload-specced" index="01" accent="green">VRAM, cores, and cooling matched to what you actually run.</FeatureCard>
      <FeatureCard title="Stress-tested" index="02" accent="signal">Sustained-load testing before it ships. Stable under long runs.</FeatureCard>
      <FeatureCard title="Linux-first" index="03" accent="violet">Ubuntu + CUDA + Docker ready; Windows on request.</FeatureCard>
      <FeatureCard title="Supported" index="04" accent="green">We stand behind the build. No finger-pointing.</FeatureCard>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 pt-6">
    <a href="/contact#request-a-build" class="inline-block rounded-sm border border-aurora-green/50 bg-aurora-green/10 px-6 py-3 font-mono text-sm font-medium text-aurora-green transition-colors hover:bg-aurora-green/20">Request a build</a>
  </section>
</Main>

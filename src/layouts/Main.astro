---
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Aurora Nyxus - Compute you own",
  description = "Aurora Nyxus builds premium AI compute workstations and sovereign on-prem AI systems for Canadians who need serious compute they control.",
} = Astro.props;

const nav = [
  { href: "/workstations", label: "Workstations" },
  { href: "/sovereign", label: "Sovereign" },
  { href: "/why-owned", label: "Why Owned" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen bg-canvas text-ink">
    <!-- Scroll-aware header -->
    <header
      id="site-header"
      class="sticky top-0 z-50 border-b border-hairline/60 bg-canvas/80 backdrop-blur transition-colors"
    >
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/" aria-label="Aurora Nyxus home" class="text-lg">
          <Wordmark />
        </a>
        <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="mono-label text-graphite transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="/contact#request-a-build"
            class="rounded-sm border border-aurora-green/40 bg-aurora-green/10 px-3 py-1.5 font-mono text-xs font-medium text-aurora-green transition-colors hover:bg-aurora-green/20"
          >
            Request a build
          </a>
        </nav>
        <a
          href="/contact"
          class="mono-label text-aurora-green md:hidden"
          aria-label="Contact">Contact</a
        >
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Partnerships banner -->
    <section class="border-t border-hairline bg-surface/40">
      <div class="mx-auto max-w-6xl px-5 py-10">
        <p class="fig-label mb-6 text-center">In partnership with</p>
        <div
          class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6"
        >
          <a
            href="https://daicompute.ca"
            target="_blank"
            rel="noopener noreferrer"
            class="font-display text-sm font-medium text-graphite transition-colors hover:text-ink"
          >
            DAI Compute
          </a>
          <span class="font-display text-sm font-medium text-graphite/50"
            >Aurora</span
          >
          <span class="mono-label text-muted">+ partners</span>
        </div>
        <p class="mt-6 text-center text-xs text-muted">
          Nominative association. Sovereignty and infrastructure-finance
          collaboration with DAI Compute (daicompute.ca).
        </p>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-hairline bg-canvas">
      <div
        class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:grid-cols-2 lg:grid-cols-4"
      >
        <div class="lg:col-span-2">
          <a href="/" class="text-base"><Wordmark /></a>
          <p class="mt-3 max-w-sm text-sm leading-relaxed text-graphite">
            Premium AI compute you own, on soil you trust. Custom workstations
            and sovereign on-prem AI systems, built in Canada.
          </p>
        </div>
        <div>
          <p class="fig-label mb-3">Build</p>
          <ul class="space-y-2 text-sm text-graphite">
            <li><a href="/workstations" class="hover:text-ink">Workstations</a></li>
            <li><a href="/sovereign" class="hover:text-ink">Sovereign deployment</a></li>
            <li><a href="/why-owned" class="hover:text-ink">Why owned</a></li>
          </ul>
        </div>
        <div>
          <p class="fig-label mb-3">Company</p>
          <ul class="space-y-2 text-sm text-graphite">
            <li><a href="/about" class="hover:text-ink">About</a></li>
            <li><a href="/contact" class="hover:text-ink">Contact</a></li>
            <li>
              <a href="https://daicompute.ca" target="_blank" rel="noopener noreferrer" class="hover:text-ink">DAI Compute</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-hairline">
        <div
          class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-5 py-5 text-xs text-muted sm:flex-row"
        >
          <p>© {year} Aurora Nyxus. Built in Canada.</p>
          <p class="font-mono">auroranyxus.com</p>
        </div>
      </div>
    </footer>

    <script>
      // Scroll-aware header: intensify border once scrolled
      const header = document.getElementById("site-header");
      if (header) {
        const onScroll = () => {
          if (window.scrollY > 8) {
            header.classList.add("border-hairline");
            header.classList.remove("border-hairline/60");
          } else {
            header.classList.add("border-hairline/60");
            header.classList.remove("border-hairline");
          }
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }
    </script>
  </body>
</html>

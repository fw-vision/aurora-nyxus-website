---
/**
 * Aurora Nyxus wordmark. Syne for brand personality;
 * "Nyxus" carries the aurora accent.
 */
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span class={`font-brand font-semibold tracking-tight ${className}`}>
  Aurora<span class="aurora-text">Nyxus</span>
</span>

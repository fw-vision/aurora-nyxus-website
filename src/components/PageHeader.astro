---
/**
 * Page header block with mono eyebrow, display title, and lede.
 * Optional aurora glow for hero contexts.
 */
export interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  glow?: boolean;
  fig?: string;
}
const { eyebrow, title, lede, glow = false, fig } = Astro.props;
---

<header class:list={["relative", glow && "aurora-glow"]}>
  <div class="relative z-10 mx-auto max-w-6xl px-5 pt-16 pb-10 sm:pt-20">
    {fig && <p class="fig-label mb-4">{fig}</p>}
    {eyebrow && <p class="mono-label mb-3 text-aurora-green">{eyebrow}</p>}
    <h1
      class="font-display max-w-3xl text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl"
    >
      {title}
    </h1>
    {
      lede && (
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-graphite">
          {lede}
        </p>
      )
    }
    <slot />
  </div>
</header>

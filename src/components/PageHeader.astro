---
/**
 * Page header. Oxide-class: generous space, track accent eyebrow, optional
 * full-bleed background image, optional large media band below copy.
 */
export interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  accent?: "green" | "violet" | "signal";
  /** Full-bleed hero background (Oxide home / product field) */
  bgSrc?: string;
  bgAlt?: string;
}
const {
  eyebrow,
  title,
  lede,
  accent = "green",
  bgSrc,
  bgAlt = "",
} = Astro.props;

const accentClass = {
  green: "text-aurora-green",
  violet: "text-aurora-violet",
  signal: "text-signal",
}[accent];

const hasMedia = Astro.slots.has("media");
---

{
  bgSrc ? (
    <header class="relative min-h-[72vh] overflow-hidden sm:min-h-[78vh]">
      <img
        src={bgSrc}
        alt={bgAlt}
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-canvas via-canvas/85 to-canvas/25"
      ></div>
      <div
        class="absolute inset-0 bg-gradient-to-t from-canvas via-transparent to-canvas/40"
      ></div>
      <div class="relative z-10 mx-auto flex min-h-[72vh] max-w-6xl flex-col justify-end px-5 pb-16 pt-28 sm:min-h-[78vh] sm:pb-20">
        {eyebrow && (
          <p class={`mono-label mb-4 ${accentClass}`}>{eyebrow}</p>
        )}
        <h1 class="font-display max-w-3xl text-4xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-6xl">
          {title}
        </h1>
        {lede && (
          <p class="mt-5 max-w-xl text-base leading-relaxed text-graphite sm:text-lg">
            {lede}
          </p>
        )}
        <div class="mt-8">
          <slot />
        </div>
      </div>
    </header>
  ) : (
    <header class="relative">
      <div class="relative z-10 mx-auto max-w-6xl px-5 pt-20 pb-12 sm:pt-28 sm:pb-16">
        {eyebrow && (
          <p class={`mono-label mb-4 ${accentClass}`}>{eyebrow}</p>
        )}
        <h1 class="font-display max-w-3xl text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
          {title}
        </h1>
        {lede && (
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-graphite">
            {lede}
          </p>
        )}
        <slot />
        {hasMedia && (
          <div class="mt-12 overflow-hidden border border-hairline bg-surface">
            <slot name="media" />
          </div>
        )}
      </div>
    </header>
  )
}

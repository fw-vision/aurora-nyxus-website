---
/**
 * Feature card. Hairline box on surface, optional mono index and accent.
 */
export interface Props {
  title: string;
  index?: string;
  accent?: "green" | "violet" | "signal" | "none";
}
const { title, index, accent = "none" } = Astro.props;
const accentClass = {
  green: "text-aurora-green",
  violet: "text-aurora-violet",
  signal: "text-signal",
  none: "text-graphite",
}[accent];
---

<article
  class="group flex flex-col border border-hairline bg-surface/50 p-6 transition-colors hover:border-graphite/40"
>
  {index && <p class={`mono-label mb-3 ${accentClass}`}>{index}</p>}
  <h3 class="font-display text-lg font-medium leading-tight text-ink">
    {title}
  </h3>
  <div class="mt-3 text-sm leading-relaxed text-graphite">
    <slot />
  </div>
</article>
